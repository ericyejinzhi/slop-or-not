# Template for the .env on the AWS server (copy it to `.env` there and fill in the <...>).
# This is NOT for local development - use .env.example for that.
#
# Start the app with:
#   docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d --build api web
# The second file stops the base file from overriding these settings with the local
# postgres/minio containers.

# --- Database: the RDS instance Terraform created ---
# `terraform output rds_endpoint` prints host:port; put only the HOST part here.
POSTGRES_HOST=<rds host, e.g. slop-or-not-db.xxxxxxxx.us-east-2.rds.amazonaws.com>
POSTGRES_PORT=5432
POSTGRES_USER=slop
POSTGRES_PASSWORD=<the TF_VAR_db_password you used for terraform>
POSTGRES_DB=slopornot
POSTGRES_SSLMODE=require

# --- Object storage: real S3 ---
# These three are deliberately BLANK. Blank means "not set": no custom endpoint (boto3 then
# finds the regional AWS S3 endpoint itself) and no keys (it then uses this instance's IAM
# role). Do NOT delete the lines instead of blanking them - an absent variable falls back to
# the local MinIO defaults, including MinIO's login keys, which would be sent to AWS.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_THUMBNAILS=<thumbnails bucket name from terraform output>
AWS_REGION=us-east-2

# --- A public, read-only server ---
# Rejects every write (no ingesting, no label writes) and hides those controls in the UI.
READ_ONLY=true

# --- Which model's scores to show ---
# Scores shown on the Videos and Channels pages come from the database, so the active
# model's files are not needed on this server.
ACTIVE_MODEL_NAME=logistic_regression
ACTIVE_MODEL_VERSION=<the version in your local .env>

# --- Checking a pasted video link (POST /predict) ---
# This is the one write-free POST a read-only server still accepts. It needs the video-only
# model (your local .env has VIDEO_ONLY_MODEL_NAME / VERSION), published to the models
# bucket with `slop model publish` (docs/deploy-runbook.md Part D), and a YouTube Data API
# key. The key is a secret: restrict it to the YouTube Data API in Google Cloud and keep
# this file out of git. Leave YOUTUBE_API_KEY blank to switch the page off.
VIDEO_ONLY_MODEL_NAME=xgboost
VIDEO_ONLY_MODEL_VERSION=<the version in your local .env>
YOUTUBE_API_KEY=<your YouTube Data API key>
FETCH_MODEL_FROM_S3=true
S3_BUCKET_MODELS=<models bucket name from terraform output>
# Everything reaches the api through the nginx container, which sets X-Real-IP, so the
# per-visitor rate limit can tell visitors apart. Only valid while the api is reachable
# ONLY through nginx (it is: the security group opens just port 80).
TRUST_PROXY_HEADERS=true
PREDICT_RATE_LIMIT_PER_HOUR=20

# Not needed on a read-only server: LABELER_NAME, WANDB_*.
