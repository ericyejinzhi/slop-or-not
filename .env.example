# Copy to .env and fill in. docker-compose and the app both read this file.

# --- PostgreSQL ---
POSTGRES_USER=slop
POSTGRES_PASSWORD=slop_dev_password
POSTGRES_DB=slopornot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (S3-compatible; swap endpoint/creds for real S3 in Phase 8) ---
MINIO_ROOT_USER=slopadmin
MINIO_ROOT_PASSWORD=slop_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=slopadmin
S3_SECRET_KEY=slop_dev_password
S3_BUCKET_THUMBNAILS=thumbnails

# --- YouTube Data API v3 (Phase 1) ---
# Create at https://console.cloud.google.com/apis/credentials (free, 10k units/day)
YOUTUBE_API_KEY=

# --- Labeling (Phase 2) ---
# Recorded on every label row; override per-run with `slop label run --labeler <name>`.
LABELER_NAME=

# --- Model training (Phase 3) ---
# Optional - training works fully without this; W&B tracking is skipped (not required)
# if left blank. Get a free key at https://wandb.ai/authorize.
WANDB_API_KEY=
WANDB_PROJECT=slop-or-not

# --- Active model (Phase 5) ---
# Optional - the API shows null scores until both are set. See docs/writeups/TODO.md item 15.
ACTIVE_MODEL_NAME=
ACTIVE_MODEL_VERSION=

# --- Model artifacts in object storage (Phase 8 prep) ---
# `slop model publish --model-name X --model-version V` uploads a trained model to this
# bucket (MinIO locally, S3 in production). With FETCH_MODEL_FROM_S3=true the API and
# flows download the ACTIVE model on demand when it is not already in models_artifacts/.
# Keep the bucket private and write-restricted: model.joblib is a pickle, so write access
# to the bucket means running code on every server that loads from it.
S3_BUCKET_MODELS=models
FETCH_MODEL_FROM_S3=false

# --- API (Phase 5) ---
API_PORT=8000
# Public deployments: set true to make the API reject every request that is not a
# GET/HEAD/OPTIONS (no ingesting channels, no writing labels) and to hide those controls
# in the dashboard. Leave false for local development (labeling and ingesting need writes).
READ_ONLY=false

# --- Orchestration (Phase 7) ---
PREFECT_PORT=4200
# Not read from .env by the app - export this in your shell (or `uv run prefect config
# set PREFECT_API_URL=...`) so `uv run prefect`/flow runs talk to the docker-compose
# server instead of spinning up a throwaway ephemeral one. See docs/writeups/TODO.md.
# PREFECT_API_URL=http://localhost:4200/api

# --- Frontend production build (Phase 8) ---
WEB_PORT=8080

# --- AWS (Phase 8, code/config prep only - no resources actually provisioned) ---
# Leave S3_ENDPOINT_URL unset (comment it out above) to use real AWS S3 instead of
# MinIO - boto3 then resolves the correct regional endpoint itself. See
# docs/writeups/phase-8 and infra/terraform/ for the full migration notes.
AWS_REGION=us-east-1
# POSTGRES_SSLMODE=require
