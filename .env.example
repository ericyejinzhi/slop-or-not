# Copy to .env and fill in. docker-compose and the app both read this file.

# --- PostgreSQL ---
POSTGRES_USER=slop
POSTGRES_PASSWORD=slop_dev_password
POSTGRES_DB=slopornot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (S3-compatible; swap endpoint/creds for real S3 in Phase 8) ---
MINIO_ROOT_USER=slopadmin
MINIO_ROOT_PASSWORD=slop_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=slopadmin
S3_SECRET_KEY=slop_dev_password
S3_BUCKET_THUMBNAILS=thumbnails

# --- YouTube Data API v3 (Phase 1) ---
# Create at https://console.cloud.google.com/apis/credentials (free, 10k units/day)
YOUTUBE_API_KEY=

# --- Labeling (Phase 2) ---
# Recorded on every label row; override per-run with `slop label run --labeler <name>`.
LABELER_NAME=
